# ============================================================================
# CANCEL BOOKING
# ============================================================================

@app.route(
    "/cancel-booking/<int:booking_id>",
    methods=["POST"]
)
def cancel_booking(booking_id):

    conn = get_db_connection()

    booking = conn.execute(
        """
        SELECT *
        FROM bookings

        WHERE id = ?
        """,
        (booking_id,)
    ).fetchone()

    if booking is None:

        conn.close()

        flash(
            "Booking not found.",
            "danger"
        )

        return redirect(
            url_for("index")
        )

    if booking["status"] == "Cancelled":

        conn.close()

        flash(
            "This booking has already been cancelled.",
            "warning"
        )

        return redirect(
            url_for(
                "booking_pass",
                booking_id=booking_id
            )
        )

    # ------------------------------------------------------------------------
    # CALCULATE DAYS REMAINING
    # ------------------------------------------------------------------------

    try:

        travel_date = datetime.strptime(
            booking["schedule_date"],
            "%Y-%m-%d"
        ).date()

        today = datetime.now().date()

        days_remaining = (
            travel_date - today
        ).days

    except (ValueError, TypeError):

        days_remaining = 0

    # ------------------------------------------------------------------------
    # CANCELLATION POLICY
    # ------------------------------------------------------------------------

    if days_remaining > 7:

        fee_percent = 10

    elif days_remaining >= 3:

        fee_percent = 25

    elif days_remaining >= 1:

        fee_percent = 50

    else:

        fee_percent = 100

    # ------------------------------------------------------------------------
    # CALCULATE REFUND
    # ------------------------------------------------------------------------

    total_bill = float(
        booking["total_bill"] or 0
    )

    cancellation_fee = (
        total_bill * fee_percent / 100
    )

    refund_amount = (
        total_bill - cancellation_fee
    )

    if refund_amount < 0:

        refund_amount = 0

    cancellation_date = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    # ------------------------------------------------------------------------
    # UPDATE BOOKING
    # ------------------------------------------------------------------------

    conn.execute(
        """
        UPDATE bookings

        SET

            status = ?,
            refund_amount = ?,
            cancellation_date = ?

        WHERE id = ?
        """,
        (
            "Cancelled",
            refund_amount,
            cancellation_date,
            booking_id
        )
    )

    conn.commit()

    conn.close()

    flash(
        f"Booking cancelled successfully. "
        f"Cancellation fee: {fee_percent}%. "
        f"Refund amount: ₹{refund_amount:,.2f}",
        "success"
    )

    return redirect(
        url_for(
            "booking_pass",
            booking_id=booking_id
        )
    )


# ============================================================================
# DELETE PACKAGE
# ============================================================================
#
# IMPORTANT:
#
# We DO NOT physically delete the package.
#
# Instead:
#
# is_deleted = 1
#
# This means:
#
# - Package disappears from home page
# - Package cannot be booked anymore
# - Existing booking history remains
# - Existing booking passes remain
# - Feedback remains
# - Foreign key errors are avoided
#
# ============================================================================

@app.route(
    "/delete/<int:package_id>",
    methods=["POST"]
)
def delete_package(package_id):

    conn = get_db_connection()

    # ------------------------------------------------------------------------
    # CHECK PACKAGE
    # ------------------------------------------------------------------------

    package = conn.execute(
        """
        SELECT *
        FROM packages

        WHERE id = ?
        """,
        (package_id,)
    ).fetchone()

    if package is None:

        conn.close()

        flash(
            "Package not found.",
            "danger"
        )

        return redirect(
            url_for("index")
        )

    # ------------------------------------------------------------------------
    # SOFT DELETE
    # ------------------------------------------------------------------------

    conn.execute(
        """
        UPDATE packages

        SET
            is_deleted = 1,
            availability = 'Unavailable'

        WHERE id = ?
        """,
        (package_id,)
    )

    conn.commit()

    conn.close()

    flash(
        f"Package '{package['package_name']}' was removed successfully. "
        f"Existing booking history has been preserved.",
        "info"
    )

    return redirect(
        url_for("index")
    )


