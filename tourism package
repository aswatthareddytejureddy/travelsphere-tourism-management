@app.route(
    "/feedback/<int:booking_id>",
    methods=["GET", "POST"]
)
def feedback(booking_id):

    conn = get_db_connection()

    # ------------------------------------------------------------------------
    # FIND BOOKING
    # ------------------------------------------------------------------------

    booking = conn.execute(
        """
        SELECT

            bookings.*,

            packages.package_name,
            packages.destination,
            packages.duration,
            packages.image_url

        FROM bookings

        LEFT JOIN packages
        ON bookings.package_id = packages.id

        WHERE bookings.id = ?
        """,
        (booking_id,)
    ).fetchone()

    if booking is None:

        conn.close()

        flash(
            "Booking not found.",
            "danger"
        )

        return redirect(
            url_for("booking_history")
        )

    # ------------------------------------------------------------------------
    # CANCELLED BOOKINGS
    # ------------------------------------------------------------------------

    if booking["status"] == "Cancelled":

        conn.close()

        flash(
            "Feedback cannot be submitted for a cancelled booking.",
            "warning"
        )

        return redirect(
            url_for("booking_history")
        )

    # ------------------------------------------------------------------------
    # CHECK EXISTING FEEDBACK
    # ------------------------------------------------------------------------

    existing_feedback = conn.execute(
        """
        SELECT *
        FROM feedback

        WHERE booking_id = ?
        """,
        (booking_id,)
    ).fetchone()

    if existing_feedback is not None:

        conn.close()

        flash(
            "Feedback has already been submitted for this booking.",
            "info"
        )

        return redirect(
            url_for("feedback_list")
        )

    # ------------------------------------------------------------------------
    # SUBMIT FEEDBACK
    # ------------------------------------------------------------------------

    if request.method == "POST":

        rating_text = request.form.get(
            "rating",
            ""
        ).strip()

        comment = request.form.get(
            "comment",
            ""
        ).strip()

        try:

            rating = int(rating_text)

        except (ValueError, TypeError):

            rating = 0

        # --------------------------------------------------------------------
        # RATING VALIDATION
        # --------------------------------------------------------------------

        if rating < 1 or rating > 5:

            conn.close()

            flash(
                "Please select a rating from 1 to 5 stars.",
                "danger"
            )

            return render_template(
                "feedback.html",
                booking=booking,
                feedbacks=[],
                form_mode=True
            )

        # --------------------------------------------------------------------
        # COMMENT VALIDATION
        # --------------------------------------------------------------------

        if not comment:

            conn.close()

            flash(
                "Please write your feedback.",
                "danger"
            )

            return render_template(
                "feedback.html",
                booking=booking,
                feedbacks=[],
                form_mode=True
            )

        if len(comment) > 1000:

            conn.close()

            flash(
                "Feedback must be 1000 characters or less.",
                "danger"
            )

            return render_template(
                "feedback.html",
                booking=booking,
                feedbacks=[],
                form_mode=True
            )

        # --------------------------------------------------------------------
        # SAVE FEEDBACK
        # --------------------------------------------------------------------

        try:

            conn.execute(
                """
                INSERT INTO feedback
                (
                    booking_id,
                    package_id,
                    customer_name,
                    rating,
                    comment,
                    feedback_date
                )

                VALUES
                (
                    ?, ?, ?, ?, ?, ?
                )
                """,
                (
                    booking["id"],
                    booking["package_id"],
                    booking["name"],
                    rating,
                    comment,
                    datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"
                    )
                )
            )

            conn.commit()

            conn.close()

            flash(
                "Thank you! Your feedback has been submitted successfully.",
                "success"
            )

            return redirect(
                url_for("feedback_list")
            )

        except sqlite3.IntegrityError:

            conn.close()

            flash(
                "Feedback has already been submitted for this booking.",
                "warning"
            )

            return redirect(
                url_for("feedback_list")
            )

    conn.close()

    return render_template(
        "feedback.html",
        booking=booking,
        feedbacks=[],
        form_mode=True
    )


