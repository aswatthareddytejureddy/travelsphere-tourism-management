"""
Tourism Package Management System
A professional Flask web application to manage travel packages
and customer bookings.
"""

from flask import Flask, render_template, request, redirect, url_for, flash
import sqlite3
import os
import re
import random
from datetime import datetime


# ============================================================================
# FLASK CONFIGURATION
# ============================================================================

app = Flask(__name__)

app.secret_key = "change-this-secret-key-in-production"

BASE_DIR = os.path.abspath(os.path.dirname(__file__))
DB_PATH = os.path.join(BASE_DIR, "tourism.db")


# ============================================================================
# DATABASE CONNECTION
# ============================================================================

def get_db_connection():

    conn = sqlite3.connect(DB_PATH)

    conn.row_factory = sqlite3.Row

    conn.execute("PRAGMA foreign_keys = ON")

    return conn


# ============================================================================
# DATABASE COLUMN CHECK
# ============================================================================

def ensure_database_columns():

    conn = get_db_connection()

    # ------------------------------------------------------------------------
    # PACKAGE COLUMNS
    # ------------------------------------------------------------------------

    package_columns = {

        "availability": "TEXT DEFAULT 'Available'",

        "famous_temple": "TEXT",
        "famous_food": "TEXT",
        "famous_dance": "TEXT",
        "famous_festival": "TEXT",

        "contact_name": "TEXT",
        "contact_phone": "TEXT",
        "contact_email": "TEXT",
        "contact_address": "TEXT",

        # 0 = visible
        # 1 = deleted / hidden
        "is_deleted": "INTEGER DEFAULT 0",
    }

    existing_columns = {
        row["name"]
        for row in conn.execute(
            "PRAGMA table_info(packages)"
        ).fetchall()
    }

    for column_name, column_type in package_columns.items():

        if column_name not in existing_columns:

            conn.execute(
                f"ALTER TABLE packages ADD COLUMN {column_name} {column_type}"
            )

    # ------------------------------------------------------------------------
    # BOOKING COLUMNS
    # ------------------------------------------------------------------------

    booking_columns = {

        "status": "TEXT DEFAULT 'Confirmed'",

        "refund_amount": "REAL DEFAULT 0",

        "cancellation_date": "TEXT",
    }

    existing_booking_columns = {
        row["name"]
        for row in conn.execute(
            "PRAGMA table_info(bookings)"
        ).fetchall()
    }

    for column_name, column_type in booking_columns.items():

        if column_name not in existing_booking_columns:

            conn.execute(
                f"ALTER TABLE bookings ADD COLUMN {column_name} {column_type}"
            )

    conn.commit()

    conn.close()


