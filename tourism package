@app.route(
    "/book/<int:package_id>",
    methods=["GET", "POST"]
)
def book_package(package_id):

    conn = get_db_connection()

    package = conn.execute(
        """
        SELECT *
        FROM packages

        WHERE id = ?

        AND is_deleted = 0
        """,
        (package_id,)
    ).fetchone()

    conn.close()

    if package is None:

        flash(
            "Package not found.",
            "danger"
        )

        return redirect(
            url_for("index")
        )

    if package["availability"] != "Available":

        flash(
            "This package is currently unavailable.",
            "warning"
        )

        return redirect(
            url_for(
                "package_detail",
                package_id=package_id
            )
        )

    # ------------------------------------------------------------------------
    # CONVERT PRICE
    # ------------------------------------------------------------------------

    price_text = package["price"] or ""

    price_match = re.search(
        r"[\d,]+",
        price_text
    )

    if price_match:

        price_per_person = float(
            price_match.group().replace(",", "")
        )

    else:

        price_per_person = 0

    # ------------------------------------------------------------------------
    # POST
    # ------------------------------------------------------------------------

    if request.method == "POST":

        name = request.form.get(
            "name",
            ""
        ).strip()

        mobile = request.form.get(
            "mobile",
            ""
        ).strip()

        address = request.form.get(
            "address",
            ""
        ).strip()

        map_link = request.form.get(
            "map_link",
            ""
        ).strip()

        schedule_date = request.form.get(
            "schedule_date",
            ""
        ).strip()

        payment_method = request.form.get(
            "payment_method",
            ""
        ).strip()

        try:

            persons = int(
                request.form.get(
                    "persons",
                    "1"
                )
            )

        except ValueError:

            persons = 1

        # --------------------------------------------------------------------
        # VALIDATION
        # --------------------------------------------------------------------

        if not name:

            flash(
                "Please enter your name.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if not mobile:

            flash(
                "Please enter your mobile number.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if not mobile.isdigit() or len(mobile) != 10:

            flash(
                "Please enter a valid 10-digit mobile number.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if not address:

            flash(
                "Please enter your address.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if not schedule_date:

            flash(
                "Please select a schedule date.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if persons < 1:

            flash(
                "Number of persons must be at least 1.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        if payment_method not in [
            "UPI",
            "Credit Card"
        ]:

            flash(
                "Please select a valid payment method.",
                "danger"
            )

            return render_template(
                "booking.html",
                package=package,
                price_per_person=price_per_person
            )

        # --------------------------------------------------------------------
        # TOTAL
        # --------------------------------------------------------------------

        total_bill = price_per_person * persons

        # --------------------------------------------------------------------
        # SAVE BOOKING
        # --------------------------------------------------------------------

        conn = get_db_connection()

        cursor = conn.execute(
            """
            INSERT INTO bookings
            (
                package_id,
                name,
                mobile,
                address,
                map_link,
                schedule_date,
                persons,
                total_bill,
                payment_method,
                booking_date,
                status,
                refund_amount,
                cancellation_date
            )

            VALUES
            (
                ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
                ?, ?, ?
            )
            """,

            (
                package_id,
                name,
                mobile,
                address,
                map_link,
                schedule_date,
                persons,
                total_bill,
                payment_method,
                datetime.now().strftime(
                    "%Y-%m-%d %H:%M:%S"
                ),
                "Confirmed",
                0,
                None
            )
        )

        booking_id = cursor.lastrowid

        conn.commit()

        conn.close()

        return redirect(
            url_for(
                "booking_pass",
                booking_id=booking_id
            )
        )

    return render_template(
        "booking.html",
        package=package,
        price_per_person=price_per_person
    )


