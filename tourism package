@app.route("/add", methods=["GET", "POST"])
def add_package():

    if request.method == "POST":

        data = _collect_form_data(request.form)

        conn = get_db_connection()

        conn.execute(
            """
            INSERT INTO packages
            (
                package_name,
                destination,
                duration,
                price,

                accommodation,
                transport,
                meals,
                sightseeing,
                activities,

                description,
                image_url,
                availability,

                famous_temple,
                famous_food,
                famous_dance,
                famous_festival,

                is_deleted
            )

            VALUES
            (
                :package_name,
                :destination,
                :duration,
                :price,

                :accommodation,
                :transport,
                :meals,
                :sightseeing,
                :activities,

                :description,
                :image_url,
                :availability,

                :famous_temple,
                :famous_food,
                :famous_dance,
                :famous_festival,

                0
            )
            """,
            data
