@app.route(
    "/edit/<int:package_id>",
    methods=["GET", "POST"]
)
def edit_package(package_id):

    conn = get_db_connection()

    package = conn.execute(
        """
        SELECT *
        FROM packages

        WHERE id = ?

        AND is_deleted = 0
        """,
        (package_id,)
    ).fetchone()

    if package is None:

        conn.close()

        flash(
            "Package not found.",
            "danger"
        )

        return redirect(
            url_for("index")
        )

    # ========================================================================
    # SAVE EDITED PACKAGE
    # ========================================================================

    if request.method == "POST":

        data = _collect_form_data(request.form)

        # --------------------------------------------------------------------
        # CONTACT INFORMATION
        # --------------------------------------------------------------------

        contact_name = request.form.get(
            "contact_name",
            ""
        ).strip()

        contact_phone = request.form.get(
            "contact_phone",
            ""
        ).strip()

        contact_email = request.form.get(
            "contact_email",
            ""
        ).strip()

        contact_address = request.form.get(
            "contact_address",
            ""
        ).strip()

        # --------------------------------------------------------------------
        # UPDATE
        # --------------------------------------------------------------------

        conn.execute(
            """
            UPDATE packages

            SET

                package_name = ?,
                destination = ?,
                duration = ?,
                price = ?,

                accommodation = ?,
                transport = ?,
                meals = ?,
                sightseeing = ?,
                activities = ?,

                description = ?,
                image_url = ?,
                availability = ?,

                famous_temple = ?,
                famous_food = ?,
                famous_dance = ?,
                famous_festival = ?,

                contact_name = ?,
                contact_phone = ?,
                contact_email = ?,
                contact_address = ?

            WHERE id = ?
            """,

            (
                data["package_name"],
                data["destination"],
                data["duration"],
                data["price"],

                data["accommodation"],
                data["transport"],
                data["meals"],
                data["sightseeing"],
                data["activities"],

                data["description"],
                data["image_url"],
                data["availability"],

                data["famous_temple"],
                data["famous_food"],
                data["famous_dance"],
                data["famous_festival"],

                contact_name,
                contact_phone,
                contact_email,
                contact_address,

                package_id
            )
        )

        conn.commit()

        conn.close()

        flash(
            "Package updated successfully!",
            "success"
        )

        # IMPORTANT:
        # detail.html is a template.
        # package_detail is the Flask endpoint.
        return redirect(
            url_for(
                "package_detail",
                package_id=package_id
            )
        )

    # ========================================================================
    # SHOW EDIT PAGE
    # ========================================================================

    conn.close()

    return render_template(
        "edit.html",
        package=package
    )


