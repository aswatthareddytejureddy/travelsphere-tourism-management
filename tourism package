@app.route("/")
def index():

    conn = get_db_connection()

    search = request.args.get(
        "search",
        ""
    ).strip()

    if search:

        packages = conn.execute(
            """
            SELECT *
            FROM packages

            WHERE is_deleted = 0

            AND (
                package_name LIKE ?
                OR destination LIKE ?
            )

            ORDER BY id DESC
            """,
            (
                f"%{search}%",
                f"%{search}%"
            )
        ).fetchall()

    else:

        packages = conn.execute(
            """
            SELECT *
            FROM packages

            WHERE is_deleted = 0

            ORDER BY id DESC
            """
        ).fetchall()

    conn.close()

    return render_template(
        "index.html",
        packages=packages,
        search=search
    )


