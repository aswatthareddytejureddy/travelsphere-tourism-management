@app.route("/booking-pass/<int:booking_id>")
def booking_pass(booking_id):

    conn = get_db_connection()

    # LEFT JOIN is important.
    # It allows old booking passes to remain available even if
    # the package has been removed from the public website.

    booking = conn.execute(
        """
        SELECT

            bookings.*,

            packages.package_name,
            packages.destination,
            packages.duration

        FROM bookings

        LEFT JOIN packages
        ON bookings.package_id = packages.id

        WHERE bookings.id = ?
        """,
        (booking_id,)
    ).fetchone()

    conn.close()

    if booking is None:

        flash(
            "Booking not found.",
            "danger"
        )

        return redirect(
            url_for("index")
        )

    contact_number = "9" + "".join(
        str(random.randint(0, 9))
        for _ in range(9)
    )

    return render_template(
        "booking_pass.html",
        booking=booking,
        contact_number=contact_number
    )


